<!-- File: Views/Controls/RomaniaMapView.xaml -->
<UserControl x:Class="GasFireMonitoringClient.Views.Controls.RomaniaMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="DarkBlue" Padding="10">
            <TextBlock Text="Romania Counties Overview" 
                      FontSize="20" 
                      FontWeight="Bold" 
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" 
                BorderBrush="Gray" 
                BorderThickness="2" 
                Background="White"
                Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Map Display -->
                <ScrollViewer Grid.Column="0"
                             x:Name="MapScrollViewer"
                             HorizontalScrollBarVisibility="Auto" 
                             VerticalScrollBarVisibility="Auto"
                             Background="AliceBlue"
                             PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                    <Viewbox x:Name="MapViewbox" 
                            Stretch="Uniform"
                            StretchDirection="Both">
                        <Canvas x:Name="MapCanvas" 
                               Width="1000" 
                               Height="700"
                               Background="Transparent">
                            <!-- SVG paths will be added here programmatically -->
                        </Canvas>
                    </Viewbox>
                </ScrollViewer>

                <!-- Slim Control Panel -->
                <Border Grid.Column="1" 
                        Background="LightGray" 
                        Width="140" 
                        Padding="5">
                    <StackPanel>

                        <!-- Reset Zoom Button -->
                        <Button x:Name="ResetZoomButton" 
                                Content="🏠 Reset" 
                                Margin="0,5" 
                                Padding="2"
                                FontSize="10"
                                Click="ResetZoom_Click"/>

                        <Separator Margin="0,5"/>

                        <!-- Auto-refresh indicator -->
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Auto-refresh: " FontSize="9"/>
                            <TextBlock x:Name="AutoRefreshStatus" Text="ON" FontSize="9" FontWeight="Bold" Foreground="Green"/>
                        </StackPanel>
                        <TextBlock x:Name="LastRefreshText" Text="Never" FontSize="8" Foreground="Gray" Margin="0,0,0,5"/>

                        <Separator Margin="0,5"/>

                        <!-- County Statistics -->
                        <TextBlock Text="Overview Stats" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Counties: " FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalCountiesText" Text="0" FontSize="9" FontWeight="Bold" Foreground="DarkBlue"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Normal: " FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="NormalCountiesText" Text="0" FontSize="9" FontWeight="Bold" Foreground="Green"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Alarms: " FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="AlarmCountiesText" Text="0" FontSize="9" FontWeight="Bold" Foreground="Orange"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="Errors: " FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="ErrorCountiesText" Text="0" FontSize="9" FontWeight="Bold" Foreground="Red"/>
                        </StackPanel>

                        <Separator Margin="0,5"/>

                        <TextBlock Text="Total Sites: " FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="TotalSitesText" Text="0" FontSize="10" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Center"/>

                        <Separator Margin="0,5"/>

                        <!-- Legend -->
                        <TextBlock Text="County Legend" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="8" Height="8" Fill="Green" Margin="0,0,3,0"/>
                            <TextBlock Text="All Normal" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="8" Height="8" Fill="Orange" Margin="0,0,3,0"/>
                            <TextBlock Text="Has Alarms" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Rectangle Width="8" Height="8" Fill="Red" Margin="0,0,3,0"/>
                            <TextBlock Text="Has Errors" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                        <Separator Margin="0,5"/>

                        <!-- Controls Info -->
                        <TextBlock Text="Controls" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>

                        <TextBlock Text="🖱️ Wheel: Zoom" FontSize="8" Margin="0,1"/>
                        <TextBlock Text="🖱️ Drag: Pan" FontSize="8" Margin="0,1"/>
                        <TextBlock Text="🖱️ Click: County" FontSize="8" Margin="0,1"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="LightGray" Padding="5">
            <TextBlock x:Name="DebugText" 
                      Text="Ready" 
                      FontFamily="Consolas" 
                      FontSize="10"/>
        </Border>
    </Grid>
</UserControl>