<!--
Romania Map View using SVG Resource
This loads the actual romania_map.svg file and makes it interactive
-->

<UserControl x:Class="GasFireMonitoringClient.Views.Controls.RomaniaMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Map Container -->
        <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="2" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- SVG Map Viewer -->
                <ScrollViewer x:Name="MapScrollViewer" 
                             Grid.Column="0"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Background="LightCyan"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">

                    <!-- Container for the SVG content -->
                    <Viewbox x:Name="MapViewbox" 
                             Stretch="Uniform" 
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">

                        <!-- This will contain the loaded SVG -->
                        <Canvas x:Name="SvgContainer" 
                                Width="1000" 
                                Height="704"
                                Background="Transparent">

                            <!-- Loading indicator -->
                            <TextBlock x:Name="LoadingText" 
                                      Canvas.Left="400" 
                                      Canvas.Top="300"
                                      Text="Loading Romania map..." 
                                      FontSize="16" 
                                      Foreground="Gray"
                                      HorizontalAlignment="Center"/>
                        </Canvas>
                    </Viewbox>
                </ScrollViewer>

                <!-- Slim Control Panel -->
                <Border Grid.Column="1" 
                        Background="LightGray" 
                        Width="120" 
                        Padding="5">
                    <StackPanel>

                        <!-- Reset Zoom Button -->
                        <Button x:Name="ResetZoomButton" 
                                Content="🏠 Reset" 
                                Margin="0,5" 
                                Padding="2"
                                FontSize="10"
                                Click="ResetZoom_Click"/>

                        <Separator Margin="0,5"/>

                        <!-- Status Summary -->
                        <TextBlock Text="Overview" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>

                        <TextBlock x:Name="TotalCountiesText" Text="Counties: 42" FontSize="9" Margin="0,1"/>
                        <TextBlock x:Name="ActiveCountiesText" Text="Active: 2" FontSize="9" Margin="0,1"/>
                        <TextBlock x:Name="TotalSitesOverviewText" Text="Sites: 10" FontSize="9" Margin="0,1"/>
                        <TextBlock x:Name="ActiveAlarmsOverviewText" Text="Alarms: 0" FontSize="9" Margin="0,1" Foreground="Red"/>

                        <Separator Margin="0,5"/>

                        <!-- Legend -->
                        <TextBlock Text="Legend" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Ellipse Width="8" Height="8" Fill="Green" Margin="0,0,3,0"/>
                            <TextBlock Text="Normal" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Ellipse Width="8" Height="8" Fill="Orange" Margin="0,0,3,0"/>
                            <TextBlock Text="Alarm" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Ellipse Width="8" Height="8" Fill="Red" Margin="0,0,3,0"/>
                            <TextBlock Text="Error" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Ellipse Width="8" Height="8" Fill="Gray" Margin="0,0,3,0"/>
                            <TextBlock Text="Offline" VerticalAlignment="Center" FontSize="8"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>